# Copy to .env and fill the values for local development
# Get DATABASE_URL from Supabase:
# 1. Go to supabase.com and sign in
# 2. Select your project
# 3. Go to Settings > Database > Connection String
# 4. Copy the connection string (URI tab) and paste below
# Example: postgresql://postgres:password@host:5432/postgres

DATABASE_URL= postgresql://postgres:[vampiroviado123]@db.xxrimrlllwlwkzyjrwdq.supabase.co:5432/postgres

# Optional: set to 'false' if you don't want to force SSL rejectUnauthorized
# For Supabase, keep it true (SSL is required)
DB_SSL=true
